# VajraShield Environment Variables Template

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Database
DB_PASSWORD=postgres-password-change-this
DATABASE_URL=postgresql://admin:postgres-password-change-this@postgres:5432/vajrashield

# Neo4j
NEO4J_PASSWORD=neo4j-password-change-this
NEO4J_URI=bolt://neo4j:7687

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka:29092

# API Gateway
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# Monitoring
GRAFANA_PASSWORD=admin-password-change-this

# Security
LOG_LEVEL=info
HOURLY_LIMIT=1000
MINUTE_LIMIT=100

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook-url

# PagerDuty Integration
PAGERDUTY_SERVICE_KEY=your-pagerduty-key

# LLM/ML Services
DETECTION_MODEL_ENDPOINT=http://detection-service:8020
DECISION_MODEL_ENDPOINT=http://decision-service:8010
